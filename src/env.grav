// env.grav — Env: the process environment plus a `.env` file, read once at
// boot and looked up in O(1) after.
//
//   Env.load()                                  // ./.env, if there is one
//   Env.get("APP_NAME", "Apogee")
//   Env.getBool("APP_DEBUG", false)             // true/false, 1/0, yes/no, on/off
//   Env.require(["APP_KEY", "DB_URL"])          // ConfigError naming every missing one
//
// A `.env` line is `KEY=value`, optionally after `export `. Values may be bare
// (an inline ` # comment` ends them), 'single-quoted' (taken literally),
// or "double-quoted" (escapes \n \t \r \" \\ \$, and may span lines). Bare and
// double-quoted values expand ${OTHER}, ${OTHER:-default} and $OTHER from
// what is already defined. A variable already set in the real environment
// wins over the file unless load() is told to overwrite.
import "std"

namespace apogee {

    // Missing or malformed configuration (an absent required variable, a bad
    // .env line, a config file that is not JSON).
    class ConfigError extends Exception {
        constructor(message: string) { super(message); }
        public fn kind() -> string { return "ConfigError"; }
    }

    class Env {
        // What load()/set() defined, by name.
        private static values: HashMap<string, string> = new HashMap<string, string>()
        // Names whose real-environment value should be ignored (load(overwrite: true)).
        private static overridden: HashSet<string> = new HashSet<string>()

        // Reads `path` (default ".env"); how many variables it defined (0 when
        // the file does not exist). With `overwrite`, its values win over the
        // real environment's.
        static fn load(path: string = ".env", overwrite: bool = false) -> int {
            let f = new File(path);
            if (!f.exists()) { return 0; }
            let parsed = Env.parse(f.readOr(""), path);
            for (k in parsed.keys()) {
                Env.values.put(k, parsed[k]);
                if (overwrite) { Env.overridden.add(k); }
            }
            return parsed.size();
        }
        // Loads `.env`, then `.env.<APP_ENV>` over it when APP_ENV is set
        // (".env.testing", ".env.production"), then `.env.local` over both.
        static fn loadAll(dir: string = ".") -> int {
            let n = Env.load(dir + "/.env");
            let stage = Env.get("APP_ENV");
            if (stage != "") { n += Env.load(dir + "/.env." + stage, true); }
            n += Env.load(dir + "/.env.local", true);
            return n;
        }

        // The value of `key`: the real environment's (unless a load overwrote
        // it), else the loaded one, else `fallback`.
        static fn get(key: string, fallback: string = "") -> string {
            if (!Env.overridden.contains(key)) {
                let real = env(key);
                if (real != "") { return real; }
            }
            return Env.values.getOr(key, fallback);
        }
        static fn has(key: string) -> bool { return (!Env.overridden.contains(key) && env(key) != "") || Env.values.containsKey(key); }
        static fn getInt(key: string, fallback: long = 0) -> long { return Integer.parseOr(Str.trim(Env.get(key)), fallback); }
        static fn getFloat(key: string, fallback: double = 0.0) -> double { return Format.toFloatOr(Str.trim(Env.get(key)), fallback); }
        // true/false, 1/0, yes/no, on/off, (true)/(false) in any case; `fallback`
        // for anything else, or when unset.
        static fn getBool(key: string, fallback: bool = false) -> bool { return Env.truth(Env.get(key), fallback); }
        // A comma-separated value as a list ("a, b,c" gives ["a", "b", "c"]).
        static fn getList(key: string) -> Array<string> {
            let out = new Array<string>();
            for (p in Str.split(Env.get(key), ",")) { let t = Str.trim(p); if (t != "") { out.push(t); } }
            return out;
        }
        // Defines (or replaces) `key` for this process's lookups.
        static fn set(key: string, value: string) { Env.values.put(key, value); Env.overridden.add(key); }
        // Forgets everything load()/set() defined (the real environment stays).
        static fn reset() { Env.values.clear(); Env.overridden.clear(); }
        // ConfigError naming every one of `keys` that has no value.
        static fn require(keys: Array<string>) {
            let missing = new Array<string>();
            for (k in keys) { if (Env.get(k) == "") { missing.push(k); } }
            if (missing.size() > 0) { throw new ConfigError("missing environment variable(s): " + Str.join(missing, ", ")); }
        }

        static fn truth(text: string, fallback: bool) -> bool {
            switch (Str.lower(Str.trim(text))) {
                case "true", "1", "yes", "on", "(true)": return true
                case "false", "0", "no", "off", "(false)", "": return text == "" ? fallback : false
                default: return fallback
            }
        }

        // ── parsing ─────────────────────────────────────────────────────────────
        // The variables `text` defines, in order of definition (a later line wins);
        // `origin` names the file in errors.
        static fn parse(text: string, origin: string = ".env") -> HashMap<string, string> {
            let out = new HashMap<string, string>();
            let i = 0;
            let n = text.length;
            let line = 1;
            while (i < n) {
                // Skip blank space and whole-line comments.
                let c = text[i] as int;
                if (c == 10) { line += 1; i += 1; continue; }
                if (c == 32 || c == 9 || c == 13) { i += 1; continue; }
                if (c == 35) { while (i < n && text[i] as int != 10) { i += 1; } continue; }   // '#'
                // KEY
                let start = i;
                while (i < n && Env.isKeyByte(text[i] as int)) { i += 1; }
                let key = text[start..i];
                if (key == "export" && i < n && (text[i] as int == 32 || text[i] as int == 9)) {
                    while (i < n && (text[i] as int == 32 || text[i] as int == 9)) { i += 1; }
                    start = i;
                    while (i < n && Env.isKeyByte(text[i] as int)) { i += 1; }
                    key = text[start..i];
                }
                while (i < n && (text[i] as int == 32 || text[i] as int == 9)) { i += 1; }
                if (key == "" || i >= n || text[i] as int != 61) {                                 // '='
                    throw new ConfigError("${origin}:${line}: expected KEY=value");
                }
                i += 1;
                while (i < n && (text[i] as int == 32 || text[i] as int == 9)) { i += 1; }
                // VALUE
                let value = "";
                let q = i < n ? text[i] as int : 0;
                if (q == 39) {                                                                     // '...'
                    let end = Env.find(text, "'", i + 1);
                    if (end < 0) { throw new ConfigError("${origin}:${line}: unterminated ' quote"); }
                    value = text[i + 1..end];
                    line += Env.count(value, 10);
                    i = end + 1;
                } else if (q == 34) {                                                              // "..."
                    let sb = new StringBuilder();
                    i += 1;
                    let closed = false;
                    while (i < n) {
                        let ch = text[i] as int;
                        if (ch == 34) { closed = true; i += 1; break; }
                        if (ch == 92 && i + 1 < n) {                                               // '\'
                            let e = text[i + 1] as int;
                            if (e == 110) { sb.appendChar(10); } else if (e == 116) { sb.appendChar(9); }
                            else if (e == 114) { sb.appendChar(13); } else if (e == 36) { sb.append("\u{1}"); }   // \$ stays literal
                            else { sb.appendChar(e); }
                            i += 2;
                            continue;
                        }
                        if (ch == 10) { line += 1; }
                        sb.appendChar(ch);
                        i += 1;
                    }
                    if (!closed) { throw new ConfigError("${origin}:${line}: unterminated \" quote"); }
                    value = Str.replace(Env.expand(sb.toString(), out), "\u{1}", "$");
                } else {                                                                           // bare
                    let s2 = i;
                    while (i < n && text[i] as int != 10) {
                        if (text[i] as int == 35 && i > s2 && (text[i - 1] as int == 32 || text[i - 1] as int == 9)) { break; }
                        i += 1;
                    }
                    value = Env.expand(Str.trim(text[s2..i]), out);
                }
                // The rest of the line may only hold a comment.
                while (i < n && text[i] as int != 10) {
                    let ch = text[i] as int;
                    if (ch == 35) { while (i < n && text[i] as int != 10) { i += 1; } break; }
                    if (ch != 32 && ch != 9 && ch != 13) { throw new ConfigError("${origin}:${line}: unexpected text after the value of ${key}"); }
                    i += 1;
                }
                out.put(key, value);
            }
            return out;
        }
        private static fn isKeyByte(c: int) -> bool {
            return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 46;
        }
        private static fn find(s: string, sub: string, from: int) -> int {
            let k = Str.indexOf(s[from..], sub);
            return k < 0 ? -1 : k + from;
        }
        private static fn count(s: string, c: int) -> int {
            let k = 0;
            for (i in 0..s.length) { if (s[i] as int == c) { k += 1; } }
            return k;
        }
        // ${NAME}, ${NAME:-default} and $NAME, from `local` (this file so far)
        // or else what Env already knows.
        static fn expand(s: string, local: HashMap<string, string>) -> string {
            if (Str.indexOf(s, "$") < 0) { return s; }
            let sb = new StringBuilder();
            let i = 0;
            let n = s.length;
            while (i < n) {
                let c = s[i] as int;
                if (c != 36 || i + 1 >= n) { sb.appendChar(c); i += 1; continue; }
                if (s[i + 1] as int == 123) {                                                      // ${...}
                    let end = Env.find(s, "}", i + 2);
                    if (end < 0) { sb.appendChar(c); i += 1; continue; }
                    let inner = s[i + 2..end];
                    let dflt = "";
                    let sep = Str.indexOf(inner, ":-");
                    if (sep >= 0) { dflt = inner[sep + 2..]; inner = inner[..sep]; }
                    let v = local.containsKey(inner) ? local[inner] : Env.get(inner);
                    sb.append(v == "" ? dflt : v);
                    i = end + 1;
                    continue;
                }
                let j = i + 1;
                while (j < n && Env.isKeyByte(s[j] as int) && s[j] as int != 46) { j += 1; }
                if (j == i + 1) { sb.appendChar(c); i += 1; continue; }
                let name = s[i + 1..j];
                sb.append(local.containsKey(name) ? local[name] : Env.get(name));
                i = j;
            }
            return sb.toString();
        }
    }
}
